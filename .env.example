# cp .env.example .env  후 키만 채우면 된다. (.env 는 .gitignore 처리됨)
#
# 프로바이더를 바꾸려면 아래 블록 중 하나만 주석 해제하고 LLM_API_KEY 를 넣는다.
# 셋 다 OpenAI Chat Completions 형식을 지원하므로 코드 변경이 필요 없다.

# ── Gemini (Google AI Studio — 무료 등급 있음) ─────────────────────────────
LLM_PROVIDER=gemini
LLM_API_KEY=

# ── Anthropic ─────────────────────────────────────────────────────────────
# LLM_PROVIDER=anthropic
# LLM_API_KEY=

# ── OpenAI ────────────────────────────────────────────────────────────────
# LLM_PROVIDER=openai
# LLM_API_KEY=

# ── 프리셋을 쓰지 않고 직접 지정 (OpenAI 호환 게이트웨이·로컬 서버 등) ──────
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=dummy
# LLM_MODEL_EXTRACT=qwen3:8b
# LLM_MODEL_REASON=qwen3:32b

# ── 역할별 모델 덮어쓰기 (미설정 시 프로바이더 기본값) ──────────────────────
# LLM_MODEL_EXTRACT=
# LLM_MODEL_REASON=

# ── Anthropic 네이티브 /messages 를 쓰고 싶을 때만 ─────────────────────────
# LLM_API_STYLE=anthropic

# ── 가격 미등록 모델의 비용을 재려면 (입력단가,출력단가 / USD per 1M) ───────
# 추정치를 코드에 박지 않는다. 공식 가격 페이지를 확인해 여기에 넣는다.
# LLM_PRICE_GPT_5_MINI=0.25,2.00
